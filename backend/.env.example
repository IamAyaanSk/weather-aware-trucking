# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Routing provider ('tomtom' or 'mapbox')
ROUTING_PROVIDER=tomtom

# TomTom Routing API
TOMTOM_API_KEY=
TOMTOM_ROUTING_BASE_URL=https://api.tomtom.com/routing/1
TOMTOM_LANGUAGE=en-US
TOMTOM_MAX_ALTERNATIVES=3

# Mapbox Directions (M2)
MAPBOX_ACCESS_TOKEN=
MAPBOX_DIRECTIONS_BASE_URL=https://api.mapbox.com/directions/v5
MAPBOX_PROFILE=driving-traffic
MAPBOX_TRUCK_RESTRICTIONS_ENABLED=true
MAPBOX_LANGUAGE=en

# Truck profile (M2)
TRUCK_HEIGHT_MM=4114
TRUCK_WIDTH_MM=2590
TRUCK_LENGTH_MM=21945
TRUCK_AXLE_COUNT=5
TRUCK_TARE_WEIGHT_LBS=30000

# Open-Meteo (M3)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_BATCH_SIZE=100
OPEN_METEO_CONCURRENCY=4

# Shared HTTP and cache settings
HTTP_TIMEOUT_SECONDS=15
PLAN_CACHE_TTL_SECONDS=3600
PLAN_CACHE_VERSION=v1

# Demo site access passphrase
SITE_ACCESS_PASSWORD=spotter2026
